{
  "name": "umbraco-mcp-editor-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Node/Docker runtime for the Umbraco Editor MCP server (no Cloudflare required)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync-editor": "bash scripts/sync-editor.sh",
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsup --watch --onSuccess \"node dist/server.js\"",
    "test": "node --test test/"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "0.8.3",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@umbraco-cms/mcp-dev": "^19.0.0-beta.3",
    "@umbraco-cms/mcp-hosted": "1.1.0",
    "@umbraco-cms/mcp-server-sdk": "^1.1.0",
    "dotenv": "^16.5.0",
    "uuid": "^11.1.0",
    "yargs": "^18.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
